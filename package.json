{
  "name": "@moritzbrantner/workflow-editor",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "homepage": "https://github.com/moritzbrantner/workflow-editor#readme",
  "bugs": {
    "url": "https://github.com/moritzbrantner/workflow-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/workflow-editor.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js"
    },
    "./share": {
      "types": "./dist/share.d.ts",
      "import": "./dist/share.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@moritzbrantner/graph-editor": "^0.1.0",
    "@moritzbrantner/ui": "^0.8.0",
    "lucide-react": "^1.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.29.7",
    "@microsoft/api-extractor": "^7.58.7",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "10.4.1",
    "@storybook/react-vite": "10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "4.1.7",
    "jsdom": "^26.1.0",
    "oxfmt": "0.52.0",
    "oxlint": "^1.61.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "10.4.1",
    "tailwindcss": "^4.3.0",
    "tsd": "^0.33.0",
    "tsup": "^8.5.0",
    "typescript": "6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "tsd": {
    "directory": "test-d",
    "compilerOptions": {
      "jsx": "react-jsx",
      "module": "NodeNext",
      "noImplicitAny": false,
      "strict": true
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/compiler.ts src/react.tsx src/editor.tsx src/history.ts src/layout.ts src/persistence.ts src/share.ts --format esm --dts --clean --out-dir dist",
    "changeset": "changeset",
    "dev": "vite --host 127.0.0.1 --port 5173 --config examples/workbench/vite.config.ts",
    "dev:source": "bun run source:prepare && bun run dev",
    "example": "vite --host 127.0.0.1 --port 5173 --config examples/workbench/vite.config.ts",
    "example:build": "vite build --config examples/workbench/vite.config.ts",
    "source:prepare": "node scripts/source-deps.mjs prepare",
    "source:status": "node scripts/source-deps.mjs status",
    "source:smoke": "node scripts/source-deps.mjs smoke",
    "source:restore": "node scripts/source-deps.mjs restore",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --format=github",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit",
    "check-types:tests": "tsc --noEmit -p tsconfig.test.json",
    "api:extract": "bun run build && api-extractor run --local",
    "api:check": "bun run build && api-extractor run",
    "types:public": "bun run build && node scripts/run-public-types.mjs",
    "coverage:check": "$(dirname $(command -v npm))/node node_modules/vitest/vitest.mjs run --coverage",
    "pack:check": "bun pm pack --dry-run",
    "smoke:package": "node scripts/smoke-package-exports.mjs",
    "smoke:packed-consumer": "node scripts/smoke-packed-consumer.mjs",
    "test": "$(dirname $(command -v npm))/node node_modules/vitest/vitest.mjs run",
    "bench": "$(dirname $(command -v npm))/node node_modules/vitest/vitest.mjs bench --passWithNoTests",
    "test:coverage": "$(dirname $(command -v npm))/node node_modules/vitest/vitest.mjs run --coverage",
    "test:playwright": "playwright test",
    "storybook": "storybook dev -p 6006 -c src/.storybook",
    "storybook:build": "storybook build -c src/.storybook -o storybook-static",
    "verify:checks": "bun run format:check && bun run lint && bun run check-types && bun run check-types:tests && bun run test && bun run coverage:check && bun run test:playwright && bun run storybook:build && bun run example:build && bun run build && bun run api:check && bun run types:public && bun run smoke:package && bun run smoke:packed-consumer && bun run pack:check",
    "verify:source": "bun run source:prepare && bun run source:smoke && bun run format:check && bun run lint && bun run check-types && bun run check-types:tests && bun run test && bun run example:build && bun run build && bun run api:check && bun run types:public && bun run smoke:package",
    "verify:registry": "bun run source:restore && bun run verify:checks",
    "verify": "bun run verify:registry"
  }
}
