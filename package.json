{
  "name": "@moritzbrantner/workflow-editor",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "bun@1.3.12",
  "homepage": "https://github.com/moritzbrantner/workflow-editor#readme",
  "bugs": {
    "url": "https://github.com/moritzbrantner/workflow-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/workflow-editor.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js"
    },
    "./share": {
      "types": "./dist/share.d.ts",
      "import": "./dist/share.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@moritzbrantner/ui": "^0.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.0",
    "typescript": "6.0.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/react.tsx src/editor.tsx src/history.ts src/persistence.ts src/share.ts --format esm --dts --clean --out-dir dist",
    "changeset": "changeset",
    "example": "vite --host 127.0.0.1 --port 5173 --config examples/workbench/vite.config.ts",
    "example:build": "vite build --config examples/workbench/vite.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --format=github",
    "prepack": "bun run build",
    "check-types": "tsc --noEmit",
    "smoke:package": "node scripts/smoke-package-exports.mjs",
    "test": "vitest run",
    "test:playwright": "playwright test",
    "verify": "bun run format:check && bun run lint && bun run check-types && bun run test && bun run test:playwright && bun run example:build && bun run build && bun run smoke:package"
  }
}
